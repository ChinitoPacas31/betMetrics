# ==============================================================================
# BetMetrics Backend - Configuración de Variables de Entorno (.env.example)
# Copia este archivo a `.env` y reemplaza los valores con tus credenciales reales.
# NUNCA subas el archivo `.env` al repositorio de control de versiones.
# ==============================================================================

# Puerto de ejecución del microservicio FastAPI
PORT=8000

# Entorno de ejecución: development | staging | production
ENVIRONMENT=development

# Token secreto administrativo para proteger endpoints críticos (Bearer Auth)
# Genera uno seguro con: openssl rand -hex 32
API_SECRET_TOKEN=betmetrics-super-secret-admin-token-2026

# Credenciales de RapidAPI (The Odds API)
RAPIDAPI_KEY=your-rapidapi-key-here
RAPIDAPI_HOST=odds.p.rapidapi.com

# Contraseña y URL de conexión a Redis (OWASP A02:2025 - Autenticación en caché)
REDIS_PASSWORD=redis_secret_pass
REDIS_URL=redis://:redis_secret_pass@localhost:6379/0
