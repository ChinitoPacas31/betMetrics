# ==============================================================================
# BetMetrics Backend - Variables para ejecutar uvicorn fuera de Docker
# Copia este archivo a `backend/.env` si corres `uvicorn app.main:app` desde
# `backend/`. Con `docker compose` se usan las variables del `.env` raíz.
# NUNCA subas `.env` al repositorio.
# ==============================================================================

PORT=8000
ENVIRONMENT=development

# Token administrativo de /api/v1/admin/sync-odds (openssl rand -hex 32)
API_SECRET_TOKEN=reemplaza-con-tu-token-secreto-administrativo

# Credenciales reales de RapidAPI (The Odds API)
RAPIDAPI_KEY=reemplaza-con-tu-rapidapi-key
RAPIDAPI_HOST=odds.p.rapidapi.com

# Logos reales de equipos (TheSportsDB). Obtén una API key en thesportsdb.com
THESPORTSDB_API_KEY=
TEAM_LOGO_CACHE_TTL_SECONDS=2592000
TEAM_LOGO_MISS_CACHE_TTL_SECONDS=86400

# PostgreSQL local (debe estar corriendo y con la base creada)
DATABASE_URL=postgresql+asyncpg://betmetrics:reemplaza-con-tu-password-postgres@localhost:5432/betmetrics

# Secreto de firma JWT (openssl rand -hex 32)
JWT_SECRET_KEY=reemplaza-con-tu-jwt-secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Redis local con contraseña
REDIS_URL=redis://:reemplaza-con-tu-password-redis@localhost:6379/0

# Orígenes permitidos por CORS (JSON array)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
