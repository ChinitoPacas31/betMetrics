# ==============================================================================
# BetMetrics - Root .gitignore
# ==============================================================================

# 1. Secretos y Variables de Entorno (Seguridad OWASP)
.env
*.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
!.env.example
!**/.env.example

# 2. Docker e Infraestructura Local
docker-compose.override.yml
redis_data/
data/
dump.rdb

# 3. Python / Backend (FastAPI)
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
ENV/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
.installed.cfg
*.egg

# 4. Node.js / Frontend (Next.js)
node_modules/
.next/
out/
build/
dist/
coverage/
.pnpm-store/
.vercel/
*.tsbuildinfo

# 5. Logs y Diagnósticos
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 6. Sistema Operativo e IDEs
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
