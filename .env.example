# ==============================================================================
# BetMetrics - Variables de Entorno Unificadas (.env.example)
# Copia este archivo a `.env` en la raíz del proyecto y configura tus credenciales.
# Tanto Docker/FastAPI como Next.js leen desde este único archivo en raíz.
# NUNCA subas el archivo `.env` al repositorio de control de versiones.
# ==============================================================================

# Puerto de ejecución del microservicio FastAPI
PORT=8000

# Entorno de ejecución: development | staging | production
ENVIRONMENT=development

# Token secreto administrativo para proteger endpoints críticos (Bearer Auth)
# Genera uno seguro con: openssl rand -hex 32
API_SECRET_TOKEN=reemplaza-con-tu-token-secreto-administrativo

# Credenciales reales de RapidAPI (The Odds API)
RAPIDAPI_KEY=reemplaza-con-tu-rapidapi-key
RAPIDAPI_HOST=odds.p.rapidapi.com

# Contraseña y URL de conexión a Redis 7 (OWASP A02:2025 - Autenticación en caché)
REDIS_PASSWORD=reemplaza-con-tu-password-redis
REDIS_URL=redis://:reemplaza-con-tu-password-redis@localhost:6379/0

# URL pública del microservicio FastAPI consumida por el cliente Next.js
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
